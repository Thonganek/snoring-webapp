{
  "name": "snoring-webapp-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Child snoring screening web app with Supabase PostgreSQL",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "check": "node scripts/check-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "deploy:api": "npx supabase functions deploy snoring-api --no-verify-jwt"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0"
  }
}
