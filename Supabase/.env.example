# Edge Function secrets only; never serve this file as part of the website.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Supabase.
APP_SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_SECRET
APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=REPLACE_WITH_STAFF_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
APP_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_WEBSITE
